.packit_cache/
work/
*.rpm
*.rpm
*.srpm
*.log
__pycache__/
.pytest_cache/
pigeon/reports/
pigeon/packages/*/*.tar.*
# Committed deliberately: small release signatures verified by %gpgverify.
# Specs reference these by exact basename and hermetic builds must not
# fetch them over the network. (Large binaries instead travel as
# hash-verified extra_sources, staged at build time by source_pipeline.py
# fetch — including grub2's lookaside archives via audit --fix.)
!pigeon/packages/*/*.sig
