.packit_cache/
work/*
*.rpm
*.rpm
*.srpm
*.log
*.crate
__pycache__/
utah-packages/
.pytest_cache/
rpm-factory/reports/
rpm-factory/packages/*/*.tar.*
# Committed deliberately: small release signatures verified by %gpgverify.
# Specs reference these by exact basename and hermetic builds must not
# fetch them over the network. (Large binaries instead travel as
# hash-verified extra_sources, staged at build time by source_pipeline.py
# fetch — including declared lookaside archives.)
!rpm-factory/packages/*/*.sig
!rpm-factory/.tine-sources/
!rpm-factory/.tine-sources/**

# Tine/Buck runtime state; only the pinned checkout and committed config stay tracked.
/.buck/
/.buckconfig.local
/tine.local.toml
