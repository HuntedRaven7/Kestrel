# Woodpecker — Hummingbird-based server image
# Layer discipline: few COPYs, fold small RUNs, declare VERSION/flavor ARGs late.
# Consumes RPM factory RPM repo by digest (Renovate-owned).
# No GUI stack — shares base stages with Warbler, stops before desktop layer.

ARG BASE_IMAGE=quay.io/hummingbird-community/bootc-os@sha256:9d69f6f33f5af87c76b0d7f49387bc4b969271a8eb788970396d6eab2b5af8a2
ARG BASE_IMAGE_SHA=sha256:5c05afed5a70b3438e5584cfe6342328e8d1a221cb6efa50913c12aa0c037393
ARG RPM_FACTORY_IMAGE=ghcr.io/huntedraven7/rpm-factory
ARG RPM_FACTORY_IMAGE_SHA=sha256:TODO_RPM_FACTORY_IMAGE_SHA

FROM ${BASE_IMAGE} AS base

# Install RPM factory repo + base packages needed for bootstrap
COPY --from=${RPM_FACTORY_IMAGE}@${RPM_FACTORY_IMAGE_SHA} /repository /etc/rpm-factory
RUN --mount=type=cache,id=dnf-cache,target=/var/cache/dnf \
    dnf -y install \
        createrepo_c \
        python3 \
        python3-dnf \
        python3-hawkey \
    && dnf clean all

# Copy manifests and scripts
COPY packages/ /etc/woodpecker/packages/
COPY contracts/ /etc/woodpecker/contracts/
COPY scripts/ /usr/libexec/woodpecker/

# Install packages from RPM factory repo + base (woodpecker.toml contract)
RUN --mount=type=cache,id=dnf-cache,target=/var/cache/dnf \
    /usr/libexec/woodpecker/install-packages.py \
        --contract /etc/woodpecker/packages/woodpecker.toml \
        --repo /etc/rpm-factory \
        --base-image ${BASE_IMAGE} \
    && dnf clean all

# Verify RPM contract (asserts installed set matches woodpecker.toml)
RUN /usr/libexec/woodpecker/verify-rpm-contract.py \
    --contract /etc/woodpecker/packages/woodpecker.toml \
    --installed-db /var/lib/rpm

# Configure server services (cockpit, ssh, uupd, bootc-auto-update, etc.)
RUN /usr/libexec/woodpecker/configure-services.sh

# Configure branding
RUN /usr/libexec/woodpecker/configure-branding.sh

# Verify server contract
RUN /usr/libexec/woodpecker/verify-server-contract.py \
    --contract /etc/woodpecker/contracts/server.toml

# Clean stage + bootc lint
RUN /usr/libexec/woodpecker/clean-stage.sh \
    && bootc container lint --fatal-warnings

# Copy system files (sshd config, cockpit, etc.)
COPY system_files/shared/ /

# Final labels
ARG IMAGE_NAME=woodpecker
ARG VERSION=testing
LABEL org.opencontainers.image.title="Woodpecker"
LABEL org.opencontainers.image.description="Hummingbird-based server"
LABEL org.opencontainers.image.source="https://github.com/HuntedRaven7/Kestrel"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.vendor="Kestrel"
LABEL containers.bootc=1

CMD ["/sbin/init"]