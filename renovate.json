{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["renovate"],
  "packageRules": [
    {
      "description": "Pigeon upstream sources - grouped PRs",
      "matchFileNames": ["pigeon/config/upstream-sources.json"],
      "groupName": "pigeon upstream sources"
    },
    {
      "description": "Quickshell must rebuild whenever Qt moves — keep coupled",
      "matchFileNames": ["pigeon/config/upstream-sources.json"],
      "matchDepNames": ["qt6-qtbase", "quickshell-mirror/quickshell"],
      "groupName": "qt-quickshell"
    },
    {
      "description": "Keep digest pins fresh (base image, pigeon SHA, uupd)",
      "matchFileNames": ["warbler/Containerfile", "woodpecker/Containerfile", "config/flavors.json"],
      "groupName": "digest pins"
    },
    {
      "description": "Shared bootc actions stay on v1",
      "matchPackageNames": ["projectbluefin/actions"],
      "allowedVersions": "/^v1\\./"
    },
    {
      "description": "Auto-merge patch/minor updates after CI passes",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "upstream-sources.json github-tags packages. Field order is load-bearing (version, url_template, sha512, stage?, note?, renovate{datasource, depName}); test_renovate_managers.py enforces full coverage.",
      "managerFilePatterns": [
        "/pigeon/config/upstream-sources\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>[^\"]+)\",\\s*\"url_template\":\\s*\"[^\"]*\",\\s*\"sha512\":\\s*\"[^\"]*\"(?:,\\s*\"stage\":\\s*\\d+)?(?:,\\s*\"note\":\\s*\"[^\"]*\")?,\\s*\"renovate\":\\s*\\{\\s*\"datasource\":\\s*\"github-tags\"\\s*,\\s*\"depName\":\\s*\"(?<depName>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "upstream-sources.json gitlab-tags packages hosted on gitlab.gnome.org (or fetched from download.gnome.org). Same field-order contract as above; the url host selects this manager so each entry matches exactly one gitlab instance.",
      "managerFilePatterns": [
        "/pigeon/config/upstream-sources\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>[^\"]+)\"\\s*,\\s*\"url_template\":\\s*\"[^\"]*(?:gitlab\\.gnome\\.org|download\\.gnome\\.org)[^\"]*\"\\s*,\\s*\"sha512\":\\s*\"[^\"]*\"[^}]*?\"renovate\":\\s*\\{\\s*\"datasource\":\\s*\"gitlab-tags\"\\s*,\\s*\"depName\":\\s*\"(?<depName>[^\"]+)\""
      ],
      "datasourceTemplate": "gitlab-tags",
      "registryUrlTemplate": "https://gitlab.gnome.org"
    },
    {
      "customType": "regex",
      "description": "upstream-sources.json gitlab-tags packages hosted on gitlab.freedesktop.org. Same field-order contract as above; the url host selects this manager so each entry matches exactly one gitlab instance.",
      "managerFilePatterns": [
        "/pigeon/config/upstream-sources\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>[^\"]+)\"\\s*,\\s*\"url_template\":\\s*\"[^\"]*gitlab\\.freedesktop\\.org[^\"]*\"\\s*,\\s*\"sha512\":\\s*\"[^\"]*\"[^}]*?\"renovate\":\\s*\\{\\s*\"datasource\":\\s*\"gitlab-tags\"\\s*,\\s*\"depName\":\\s*\"(?<depName>[^\"]+)\""
      ],
      "datasourceTemplate": "gitlab-tags",
      "registryUrlTemplate": "https://gitlab.freedesktop.org"
    },
    {
      "customType": "regex",
      "description": "Containerfile BASE_IMAGE digest pin",
      "managerFilePatterns": [
        "/warbler/Containerfile$/",
        "/woodpecker/Containerfile$/"
      ],
      "matchStrings": [
        "ARG BASE_IMAGE=quay\\.io/hummingbird-community/bootc-os@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/hummingbird-community/bootc-os"
    },
    {
      "customType": "regex",
      "description": "Containerfile PIGEON_IMAGE_SHA digest pin (active once pigeon publishes)",
      "managerFilePatterns": [
        "/warbler/Containerfile$/",
        "/woodpecker/Containerfile$/"
      ],
      "matchStrings": [
        "ARG PIGEON_IMAGE_SHA=(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/huntedraven7/pigeon"
    },
    {
      "customType": "regex",
      "description": "config/flavors.json uupd version",
      "managerFilePatterns": [
        "/config/flavors\\.json$/"
      ],
      "matchStrings": [
        "\"uupd_version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "ublue-os/uupd"
    },
    {
      "customType": "regex",
      "description": "upstream-sources.json regex packages - alsa-tools from alsa-project.org",
      "managerFilePatterns": [
        "/pigeon/config/upstream-sources\\.json$/"
      ],
      "matchStrings": [
        "\"alsa-tools\":\\s*\\{[^}]*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "regex",
      "depNameTemplate": "https://www.alsa-project.org/"
    },
    {
      "customType": "regex",
      "description": "upstream-sources.json regex packages - ffmpeg from ffmpeg.org",
      "managerFilePatterns": [
        "/pigeon/config/upstream-sources\\.json$/"
      ],
      "matchStrings": [
        "\"ffmpeg\":\\s*\\{[^}]*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "regex",
      "depNameTemplate": "https://ffmpeg.org/releases/"
    },
    {
      "customType": "regex",
      "description": "upstream-sources.json regex packages - git from kernel.org",
      "managerFilePatterns": [
        "/pigeon/config/upstream-sources\\.json$/"
      ],
      "matchStrings": [
        "\"git\":\\s*\\{[^}]*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "regex",
      "depNameTemplate": "https://www.kernel.org/pub/software/scm/git/"
    },
    {
      "customType": "regex",
      "description": "upstream-sources.json regex packages - linux-firmware from kernel.org",
      "managerFilePatterns": [
        "/pigeon/config/upstream-sources\\.json$/"
      ],
      "matchStrings": [
        "\"linux-firmware\":\\s*\\{[^}]*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "regex",
      "depNameTemplate": "https://www.kernel.org/pub/linux/kernel/firmware/"
    },
    {
      "customType": "regex",
      "description": "upstream-sources.json regex packages - grub2 from ftp.gnu.org",
      "managerFilePatterns": [
        "/pigeon/config/upstream-sources\\.json$/"
      ],
      "matchStrings": [
        "\"grub2\":\\s*\\{[^}]*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "regex",
      "depNameTemplate": "https://ftp.gnu.org/gnu/grub/"
    },
    {
      "customType": "regex",
      "description": "upstream-sources.json regex packages - polkit-gnome from download.gnome.org",
      "managerFilePatterns": [
        "/pigeon/config/upstream-sources\\.json$/"
      ],
      "matchStrings": [
        "\"polkit-gnome\":\\s*\\{[^}]*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "regex",
      "depNameTemplate": "https://download.gnome.org/sources/polkit-gnome/"
    }
  ]
}
